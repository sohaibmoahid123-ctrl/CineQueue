const fs = require('fs');

async function getWasm() {
    try {
        console.log('در حال دانلود فایل WASM...');
        const response = await fetch('https://www.1shows.org/makimaDL.9456ca5d8105cbf7.wasm');
        
        if (!response.ok) {
            throw new Error(`خطا در دریافت فایل: ${response.status}`);
        }
        
        const arrayBuffer = await response.arrayBuffer();
        fs.writeFileSync('makimaDL.wasm', Buffer.from(arrayBuffer));
        console.log('فایل makimaDL.wasm با موفقیت در پوشه اصلی ذخیره شد!');
    } catch (err) {
        console.error('خطا:', err.message);
    }
}

getWasm();
