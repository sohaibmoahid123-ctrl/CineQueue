{
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Content-Type", "value": "application/json" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/movies/featured", "destination": "/api/movies/featured/index.json" },
    { "source": "/api/movies", "destination": "/api/movies/index.json" },
    { "source": "/api/genres", "destination": "/api/genres/index.json" },
    { "source": "/api/watchlist", "destination": "/api/watchlist/index.json" },
    
    { "source": "/api-viduki/:path*", "destination": "https://api.viduki.net/:path*" },
    { "source": "/api-1shows/:path*", "destination": "https://www.1shows.org/:path*" },

    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
